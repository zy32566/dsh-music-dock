{
  "name": "dsh-music-dock",
  "version": "0.1.0",
  "description": "Always-visible music dock in the DSH sidebar: cover, title/artist, synced lyrics with translation, transport, queue, search, your own playlists and the AI DJ — driving @doitian/dsh-music's host.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "patches/",
    "tools/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "music",
    "netease",
    "netease-cloud-music",
    "player",
    "lyrics",
    "sidebar"
  ],
  "license": "MIT",
  "author": "<YOUR NAME>",
  "homepage": "https://github.com/<you>/dsh-music-dock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<you>/dsh-music-dock.git"
  },
  "bugs": {
    "url": "https://github.com/<you>/dsh-music-dock/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
